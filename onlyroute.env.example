# Alternativa ao cofre do Windows. O jeito recomendado e: .\onlyroute.ps1 login
#
# Copie para onlyroute.env e preencha. O prefixo e o campo "credentials" do
# vpns.json. A senha e opcional: se ficar vazia, o "up" pede. Se preencher, ela
# fica em texto puro neste arquivo -- nao compartilhe o onlyroute.env.

EMPRESA_USER=
EMPRESA_PASSWORD=
